# Reference only: the app reads environment variables, not this file automatically.
# Set real values in Render Environment. Never commit a real .env file.
DATABASE_URL=sqlite:///finance.db
TELEGRAM_BOT_TOKEN=replace_with_new_private_token
OWNER_CHAT_ID=replace_with_your_private_chat_id
INGEST_SECRET=replace_with_random_secret_at_least_32_characters
WEBHOOK_SECRET=replace_with_another_random_secret_at_least_32_characters
SUMMARY_HOUR=8
PUBLIC_BASE_URL=https://your-service.onrender.com
